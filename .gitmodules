[submodule ".config/kak"]
	path = .config/kak
	url = https://github.com/jcomcl/kak.git
[submodule ".config/mpv/scripts/mpv-cut"]
	path = .config/mpv/scripts/mpv-cut
	url = https://github.com/familyfriendlymikey/mpv-cut.git
[submodule ".config/mpv/shaders/mpv-retro-shaders"]
	path = .config/mpv/shaders/mpv-retro-shaders
	url = https://git.sr.ht/~taiite/mpv-retro-shaders
[submodule ".config/zsh"]
	path = .config/zsh
	url = https://github.com/JCoMcL/zshrc.git
[submodule "bin"]
	path = bin
	url = https://github.com/jcomcl/scripts.git
[submodule "src/.local/share/new"]
	path = .local/share/new
	url = https://github.com/jcomcl/templates.git
