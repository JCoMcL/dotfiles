# linopen configuration
# environment variables can be used

# Specify your terminal emulator here
# for terminal support.
terminal=alacritty

# Specify all programs you want to
# open in terminal like this:
interm=lf
interm=kak
interm=fluidsynth

# 1. File extension
.html:$BROWSER
.dat:nbteditor
.nbt:nbteditor
.md:marktext
.gif:imv
.blend:blender #delete this sht rn
.xcf:gimp
.kra:krita
.obj:f3d
.stl:f3d
.otf:display
.ttf:display
.kdenlive:kdenlive
.godot:godot
.aseprite:aseprite
.jar:java -jar
.mid:fluidsynth
.ardour:ardour9
.3ds:azahar
.mp3:mpv

# 2. Mime type
application/pdf:zathura
application/epub+zip:zathura
application/x-bittorrent:transadd
application/x-wii-rom:dolphin-emu-nogui
x-scheme-handler/magnet:transadd
application/vnd.ms-opentype:display

# 3. Mime category
image:imv-dir
audio:mpv
video:mpv
model:f3d
text:$EDITOR
font:display

# 4. Regexp
# Match some protocols by default
?'^http:\/\/':$BROWSER
?'^http.:\/\/':$BROWSER

directory:lf

default:/usr/bin/xdg-open

